# Vertex AI Job Finder - Environment Variables
# Copy this to .env.local and fill in your values

# Google Cloud Project
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Regions for each model
GOOGLE_CLOUD_REGION_CLAUDE=us-east5
GOOGLE_CLOUD_REGION_GEMINI=us-central1

# Service account key (base64 encoded)
# To encode: base64 -w0 your-service-account-key.json
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Model IDs (optional - defaults are set in the script)
CLAUDE_MODEL_ID=claude-opus-4-6@20250514
GEMINI_MODEL_ID=gemini-3.1-pro
